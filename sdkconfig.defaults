# Board: ESP32-S3-WROOM-1 N16R8
#   - 16 MB Quad SPI flash
#   - 8 MB Octal SPI PSRAM
# These defaults are applied when sdkconfig is (re)generated.

CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 8 MB Octal PSRAM @ 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# USB OTG as UAC 2.0 device: 2-channel mic only (no speaker), 16 kHz/16-bit.
# Must match MIC_CHANNELS / MIC_SAMPLE_RATE in components/hal/mic/mic.h.
CONFIG_UAC_TUSB_MANUFACTURER="MACJr"
CONFIG_UAC_TUSB_PRODUCT="MACJr Mic"
CONFIG_UAC_SPEAKER_CHANNEL_NUM=0
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=16000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_MIC_INTERVAL_MS=10
CONFIG_UAC_SUPPORT_MACOS=y
