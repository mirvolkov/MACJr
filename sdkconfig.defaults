# Board: ESP32-S3-WROOM-1 N16R8
#   - 16 MB Quad SPI flash
#   - 8 MB Octal SPI PSRAM
# These defaults are applied when sdkconfig is (re)generated.

CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 8 MB octal PSRAM (N16R8). It uses GPIO33-37: keep them free (the LCD
# reset used to be on GPIO35, which corrupted PSRAM data -- heap hangs,
# IWDT resets; it is on GPIO14 now). No memory test at boot: it is slow.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_MEMTEST is not set

# USB OTG as UAC 2.0 device: 2-channel mic only (no speaker), 16 kHz/16-bit.
# Must match MIC_CHANNELS / MIC_SAMPLE_RATE in components/hal/mic/mic.h.
# TinyUSB config and descriptors come from components/hal/usbdev (UAC mic
# or SD card drive), so usb_device_uac runs as one part of that device.
CONFIG_USB_DEVICE_UAC_AS_PART=y
CONFIG_UAC_SPEAKER_CHANNEL_NUM=0
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=16000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_MIC_INTERVAL_MS=2
CONFIG_UAC_SUPPORT_MACOS=y

# 1 ms tick: the UAC mic task paces itself with vTaskDelayUntil(MIC_INTERVAL_MS),
# which would round to 0 ticks (assert) at the default 100 Hz.
CONFIG_FREERTOS_HZ=1000

# Boot speed: skip app image validation when waking from deep sleep.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
# Keep FATFS sector buffers in internal RAM. In PSRAM the SD card's SPI DMA
# writes into them while the cache holds the same lines, and the PSRAM heap
# metadata got corrupted (malloc hanging forever, IWDT reset).
# CONFIG_FATFS_ALLOC_PREFER_EXTRAM is not set
# Flash runs in DIO. QIO was switched off while hunting the PSRAM heap hang
# above; that hang also happened in DIO, so QIO was not its cause.

# Run-time stats for the system monitor's per-core CPU load.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# app_main runs the MK-52 calculator, whose float formatting needs stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Run the CPU at its maximum clock.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ELF loader (components/exec): programs from the SD card are loaded into
# PSRAM and run through its instruction bus alias. The sys_* API is
# registered at run time, so only the built-in libc table is needed.
CONFIG_ELF_LOADER=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y
CONFIG_ELF_LOADER_LIBC_SYMBOLS=y
# CONFIG_ELF_LOADER_ESPIDF_SYMBOLS is not set
# CONFIG_ELF_LOADER_CUSTOMER_SYMBOLS is not set

# Wi-Fi (components/hal/net): the firmware outgrew the 1 MB app partition,
# so the single-app layout with a 1.5 MB one. Wi-Fi and lwIP buffers go to
# PSRAM where they can, to spare internal RAM; the TCP/IP task stays on
# CPU0 with the Wi-Fi task, leaving CPU1 to programs.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Trim Wi-Fi static DMA buffers to reclaim internal SRAM (Wi-Fi is low-traffic here)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
