# Board: ESP32-S3-WROOM-1 N16R8
#   - 16 MB Quad SPI flash
#   - 8 MB Octal SPI PSRAM
# These defaults are applied when sdkconfig is (re)generated.

CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 8 MB Octal PSRAM @ 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# USB OTG as UAC 2.0 device: 2-channel mic only (no speaker), 16 kHz/16-bit.
# Must match MIC_CHANNELS / MIC_SAMPLE_RATE in components/hal/mic/mic.h.
CONFIG_UAC_TUSB_MANUFACTURER="MACJr"
CONFIG_UAC_TUSB_PRODUCT="MACJr Mic"
CONFIG_UAC_SPEAKER_CHANNEL_NUM=0
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=16000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_MIC_INTERVAL_MS=2
CONFIG_UAC_SUPPORT_MACOS=y

# 1 ms tick: the UAC mic task paces itself with vTaskDelayUntil(MIC_INTERVAL_MS),
# which would round to 0 ticks (assert) at the default 100 Hz.
CONFIG_FREERTOS_HZ=1000

# Boot speed: skip app image validation when waking from deep sleep.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
# Keep the boot-time PSRAM test. Without it we get hangs in the PSRAM heap
# (malloc never returning, IWDT reset) at both 160 and 240 MHz; with it the
# board runs fine. Root cause not found yet -- the test may only mask it.
CONFIG_SPIRAM_MEMTEST=y
# Flash runs in DIO. QIO was switched off while hunting the PSRAM heap hang
# above; that hang also happened in DIO, so QIO was not its cause.

# Run-time stats for the system monitor's per-core CPU load.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# app_main runs the MK-52 calculator, whose float formatting needs stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Run the CPU at its maximum clock.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
